// Chatter database schema.
//
// Tenant isolation is enforced by Postgres Row-Level Security (see
// db/migrations/0001_init_rls.sql), not by application code alone — see
// docs/adr/0003-auth-multi-tenancy.md. Every tenant-scoped model here
// carries orgId; the migration adds the matching RLS policy for each.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  owner
  admin
  member
}

model Org {
  id                       String    @id @default(uuid())
  name                     String
  createdAt                DateTime  @default(now())
  // Null until the onboarding flow (app/onboarding/) completes — see
  // ADR 0012. app/(console)/layout.tsx redirects here on every request
  // until this is set, so a brand-new org can never reach the console
  // shell without naming itself and creating its first bot.
  onboardedAt              DateTime?
  // Optional BYOA (ADR 0012): null means "use our managed
  // ANTHROPIC_API_KEY"; set means this org's bots call Claude with
  // their own key instead. AES-256-GCM via lib/crypto.ts, never the
  // raw key — same treatment as Integration.accessToken below.
  anthropicApiKeyEncrypted String?

  memberships Membership[]
  bots        Bot[]

  @@map("orgs")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  // "salt:hash" (scrypt) — see lib/password.ts. ADR 0006: email+password
  // replaced Google OAuth (ADR 0004) for local-dev friction reasons.
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  @@map("users")
}

// A user's role within one org. A user can belong to multiple orgs
// (e.g. an agency managing several stores' bots).
model Membership {
  id        String         @id @default(uuid())
  orgId     String
  userId    String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())

  org  Org  @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@map("memberships")
}

// Deliberately NOT covered by RLS — same reasoning as BotPublicKey.
// Resolving "which org(s) can this user reach" at login time has to run
// before app.org_id is known, so it can't go through Membership (RLS-
// protected, correctly). Holds nothing but an id pairing, kept in sync
// whenever a Membership is created — see lib/auth.ts. If Membership
// deletion (removing a teammate) is ever built, it must delete the
// matching row here too, or a removed member keeps login access.
model UserOrgAccess {
  userId String
  orgId  String

  @@id([userId, orgId])
  @@map("user_org_access")
}

model Bot {
  id         String    @id @default(uuid())
  orgId      String
  name       String
  createdAt  DateTime  @default(now())
  // Soft delete (ADR 0018) — never hard-deleted. Set when a business
  // archives a bot from the console; null for a live bot. Every
  // bot-fetching query in the app must filter archivedAt: null, or an
  // archived bot silently reappears somewhere (no structural enforcement
  // for this, unlike withOrgContext for tenant isolation — see the ADR).
  archivedAt DateTime?

  org            Org                @relation(fields: [orgId], references: [id])
  versions       BotConfigVersion[]
  sources        KnowledgeSource[]
  integrations   Integration[]
  conversations  Conversation[]
  leads          Lead[]
  customActions  CustomAction[]
  pendingActions PendingAction[]
  widgets        Widget[]
  publicKey      BotPublicKey?

  @@index([orgId])
  @@map("bots")
}

// A business's connected external platform (Shopify, etc.) — the
// self-serve "Connect X" OAuth flow from docs/architecture.md §2 writes
// here. Tool handlers (lib/ai/tools/) read this to know whether a real
// integration exists or they must fall back to handoff (guardrail #4).
model Integration {
  id          String   @id @default(uuid())
  orgId       String
  botId       String
  provider    String // "shopify" for v1; more as platforms are added
  shopDomain  String?
  accessToken String // AES-256-GCM via lib/crypto.ts (ADR 0012) — never the raw token
  connectedAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id])

  @@unique([botId, provider])
  @@index([orgId])
  @@map("integrations")
}

enum ConfigStatus {
  draft
  published
}

// Draft/publish versioning per docs/architecture.md §5. Editing a bot
// always creates or updates the current `draft` row; publishing snapshots
// it into a new immutable `published` row. The bot engine only ever reads
// the latest `published` version — see lib/ai/systemPrompt.ts.
model BotConfigVersion {
  id          String       @id @default(uuid())
  orgId       String
  botId       String
  version     Int
  status      ConfigStatus @default(draft)
  persona     String
  guardrails  String
  tools       Json         @default("[]")
  appearance  Json         @default("{}")
  // Chatbase's "Build > Instructions" model picker + temperature slider
  // (docs/research/competitive-landscape.md's 2026-09-28 update). Only a
  // same-vendor Claude tier, not a multi-provider picker (ADR 0002 scoped
  // Claude as the only real ModelGateway implementation) — see the new
  // ADR for this feature. Defaults match what lib/ai/gateway.ts already
  // hardcoded before this migration, so existing published bots keep
  // their exact current behavior with no data backfill needed.
  model       String       @default("claude-sonnet-5")
  temperature Float        @default(1)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  bot Bot @relation(fields: [botId], references: [id])

  @@unique([botId, version])
  @@index([orgId])
  @@map("bot_config_versions")
}

// Knowledge base source (docs/architecture.md §1). Chunked + embedded
// into KnowledgeChunk for RAG retrieval; the pgvector column is added in
// db/migrations/0002_pgvector.sql since Prisma can't declare `vector`
// natively.
model KnowledgeSource {
  id        String   @id @default(uuid())
  orgId     String
  botId     String
  kind      String // "file" | "qa" | "url" — open per docs/open-questions.md #4 (crawling)
  title     String
  createdAt DateTime @default(now())

  bot    Bot              @relation(fields: [botId], references: [id])
  chunks KnowledgeChunk[]

  @@index([orgId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id       String @id @default(uuid())
  orgId    String
  sourceId String
  content  String

  source KnowledgeSource @relation(fields: [sourceId], references: [id])

  @@index([orgId])
  @@map("knowledge_chunks")
}

enum MessageRole {
  user
  assistant
}

// Conversation history lives here, not in server memory — the chat API
// route (app/api/chat/route.ts) is stateless: every request loads what
// it needs from the DB and persists what changed. That's what lets any
// server instance handle any request, no sticky sessions, no in-memory
// state to lose on restart or scale out.
model Conversation {
  id              String   @id @default(uuid())
  orgId           String
  botId           String
  // Config version pinned at conversation start (docs/architecture.md §5
  // — a publish mid-conversation must not shift an in-flight visitor).
  configVersionId String
  createdAt       DateTime @default(now())
  // ADR 0027: "ongoing" | "paused" — exactly the two values Chatbase's
  // own real API documents (their own filter dialog lists more, but
  // only these two are confirmed from a primary source). A paused
  // conversation still records incoming Message rows; lib/ai/chat.ts
  // skips the model call and tool loop while paused.
  status          String   @default("ongoing")
  // ADR 0027: "widget" | "playground" — this bot's two real message
  // origins (app/api/chat/route.ts vs. sendPreviewMessageAction).
  source          String   @default("widget")

  bot      Bot       @relation(fields: [botId], references: [id])
  messages Message[]

  @@index([orgId])
  @@map("conversations")
}

// collect_lead tool (lib/ai/tools/collectLead.ts) — generic across every
// vertical (guardrail #2), not ecommerce-specific: any business wants a
// visitor's contact info captured when the bot can't fully help. At
// least one of name/email/phone is expected to be present (enforced by
// the tool's input schema, not here) — all nullable at the DB level
// since a visitor may give only one.
model Lead {
  id             String   @id @default(uuid())
  orgId          String
  botId          String
  conversationId String?
  name           String?
  email          String?
  phone          String?
  note           String?
  createdAt      DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id])

  @@index([orgId])
  @@map("leads")
}

// Business-defined webhook action (ADR 0022) — matches Chatbase's Custom
// Actions. Per-bot, not a registry entry: name/description/schema/URL are
// business-authored data, built into a `Tool` at request time
// (lib/ai/tools/customAction.ts), not a compile-time addition to
// lib/ai/tools/registry.ts. Takes effect immediately on save/toggle, same
// precedent as Integration — not gated behind the bot's draft/publish
// cycle (ADR 0022's "Consequences").
model CustomAction {
  id               String   @id @default(uuid())
  orgId            String
  botId            String
  name             String // slug; the tool name Claude sees is `custom_<name>`
  description      String
  method           String // "GET" | "POST" | "PUT" | "PATCH"
  url              String
  headersEncrypted String? // AES-256-GCM (lib/crypto.ts), same as Integration.accessToken
  inputSchema      Json // JSON Schema {properties, required} for what Claude collects
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id])

  @@unique([botId, name])
  @@index([orgId])
  @@map("custom_actions")
}

// In-chat interactive widget (ADR 0028) — a form the bot can render
// inline in a conversation, matching Chatbase's own "Widgets" feature's
// smallest useful slice: a Schema-driven form with no Functions/States
// yet (those are separate, larger follow-ups per the ADR). Per-bot, not
// draft/publish-gated — same precedent as CustomAction (ADR 0022):
// takes effect immediately on save/toggle.
model Widget {
  id                 String   @id @default(uuid())
  orgId              String
  botId              String
  name               String // slug; the tool name Claude sees is `render_widget_<name>`
  triggerDescription String // model-facing: when should the bot show this widget
  submitLabel        String   @default("Submit")
  schema             Json // JSON Schema {properties, required} — the form's fields
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id])

  @@unique([botId, name])
  @@index([orgId])
  @@map("widgets")
}

model Message {
  id             String      @id @default(uuid())
  orgId          String
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([orgId])
  @@map("messages")
}

// Deliberately NOT covered by Row-Level Security (see
// db/migrations/0001_init_rls.sql's comment on this table). This table's
// only job is resolving an opaque public key — the one embedded in a
// business's widget script tag — to {orgId, botId} server-side, so
// app/api/chat/route.ts never trusts a client-supplied orgId (closes the
// gap flagged in docs/open-questions.md 1a). It holds no tenant data,
// only an opaque-key-to-ID mapping, same trust model as a Stripe
// publishable key: public by design, grants nothing beyond "talk to this
// one bot as an anonymous visitor."
model BotPublicKey {
  publicKey String   @id @default(cuid())
  botId     String   @unique
  orgId     String
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id])

  @@map("bot_public_keys")
}

// Guardrail #6 (traceability): every tool call made during a chat turn
// is logged here, independent of whether its result made it into the
// final answer. Closes docs/open-questions.md 1b.
model ToolCallLog {
  id             String   @id @default(uuid())
  orgId          String
  conversationId String
  toolName       String
  input          Json
  output         String
  createdAt      DateTime @default(now())

  @@index([orgId])
  @@map("tool_call_logs")
}

// A write-capable tool's proposed action, queued for human approval
// (ADR 0023) — never executed by the model directly. `toolName` +
// `input` are what the model proposed (e.g. "request_order_cancellation",
// {orderNumber}); `result` is set once resolved (the real API's outcome
// on approve, or null on reject). No relation to Conversation, same
// precedent as ToolCallLog above — this is an append-mostly audit-style
// table, not something joined against conversations in a query today.
enum PendingActionStatus {
  pending
  approved
  rejected
  failed
}

model PendingAction {
  id             String              @id @default(uuid())
  orgId          String
  botId          String
  conversationId String
  toolName       String
  input          Json
  status         PendingActionStatus @default(pending)
  result         String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  bot Bot @relation(fields: [botId], references: [id])

  @@index([orgId])
  @@map("pending_actions")
}
